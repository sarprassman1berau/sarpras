rules_version = '2';
// Aturan keamanan Sarpras SMAN 1 Berau.
// - Master  : email di daftar isMaster(). Membaca dan menulis semua data.
// - Operator: punya dokumen akun/{uid} dengan aktif == true. Membaca semua data,
//             tetapi hanya boleh menulis usulannya sendiri (usulan/{uid}) dan foto baru.
//             Perubahan operator baru berlaku setelah master menyetujuinya di aplikasi.
//             Menu dan tombol dibatasi sesuai centang hak akses di akun/{uid}.izin.
// - Catatan temuan: operator dengan hak "catatan" menulis langsung (tanpa validasi),
//             dan hanya boleh mengubah status serta tindak lanjutnya.
// - Selain itu: tidak bisa membaca atau menulis apa pun.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMaster() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ["sarpras.sman1berau@gmail.com"];
    }
    function isOperator() {
      return signedIn()
        && exists(/databases/$(database)/documents/akun/$(request.auth.uid))
        && get(/databases/$(database)/documents/akun/$(request.auth.uid)).data.aktif == true;
    }
    function isMember() { return isMaster() || isOperator(); }
    // aplikasi yang aktif bawaan (tanpa centang = boleh), mis. Usulan RKAS untuk seluruh GTK
    function appOn(k) {
      return isMaster() || (isOperator() && (!('izin' in akunData()) || akunData().izin.get(k, true) == true));
    }
    // hak akses operator (akun/{uid}.izin). Akun lama tanpa izin = akses penuh staf.
    function akunData() { return get(/databases/$(database)/documents/akun/$(request.auth.uid)).data; }
    function izin(k) {
      return isMaster() || (isOperator() && (!('izin' in akunData()) || akunData().izin.get(k, false) == true));
    }
    // hak yang harus dicentang khusus (akun tanpa centang = tidak boleh)
    function izinKhusus(k) {
      return isMaster() || (isOperator() && ('izin' in akunData()) && akunData().izin.get(k, false) == true);
    }

    // semua data: anggota membaca, hanya master menulis.
    // Data keuangan (koleksi berawalan keu_) hanya dibaca akun yang dicentang aplikasi Keuangan.
    match /{col}/{docId=**} {
      allow read: if isMember() && (!col.matches('keu_.*') || izinKhusus('app_keuangan')
        || ((col == 'keu_usul' || col == 'keu_kak') && appOn('app_gtk')));
      allow write: if isMaster();
    }
    // daftar akun: dibaca anggota (untuk menampilkan nama), dibaca juga oleh pemilik akunnya
    match /akun/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
    }
    // usulan perubahan: operator menulis dokumen usulannya sendiri
    match /usulan/{uid} {
      allow write: if isOperator() && request.auth.uid == uid;
    }
    // foto: operator boleh menambah foto baru (ukuran dibatasi), tidak boleh mengubah/menghapus
    match /foto/{id} {
      allow create: if isOperator()
        && request.resource.data.keys().hasOnly(["data", "by", "at"])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 600000;
    }
    // status terkini: setiap akun hanya memperbarui status dirinya sendiri
    match /online/{uid} {
      allow write: if isMember() && request.auth.uid == uid;
    }
    // chat tim: semua akun aktif boleh mengirim pesan atas namanya sendiri; hanya master yang menghapus
    match /chat/{id} {
      allow create: if isMember()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.teks is string
        && request.resource.data.teks.size() <= 2000;
    }
    // jadwal ruang (Aula & Multimedia): semua akun membaca; mengajukan dan menyetujui sesuai centang
    match /pinjam/{id} {
      allow create: if izinKhusus('jadwal_ajukan')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.st == 'Diajukan'
        && request.resource.data.kegiatan is string
        && request.resource.data.kegiatan.size() < 300;
      allow update: if izinKhusus('jadwal_setuju')
        || (resource.data.by == request.auth.uid && isMember()
            && request.resource.data.st == 'Dibatalkan'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'okBy', 'okAt']));
    }
    // permintaan barang persediaan: semua akun aktif mengajukan atas namanya sendiri;
    // yang dicentang "Memproses permintaan persediaan" menyerahkan/menolak; pemohon boleh membatalkan
    match /minta/{id} {
      allow create: if isMember()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.st == 'Diajukan'
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
      allow update: if izinKhusus('minta_proses')
        || (resource.data.by == request.auth.uid && isMember()
            && resource.data.st == 'Diajukan'
            && request.resource.data.st == 'Dibatalkan'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'okBy', 'okAt']));
    }
    // penyerahan permintaan langsung mencatat persediaan keluar (tanpa menunggu validasi)
    match /psd_trx/{id} {
      allow create: if izinKhusus('minta_proses')
        && request.resource.data.jenis == 'keluar'
        && request.resource.data.minta is string
        && request.resource.data.oleh == request.auth.uid;
    }
    // ===== Keuangan: ditulis langsung sesuai centang hak akses (tanpa validasi master) =====
    // usulan & KAK: pengusul menulis miliknya selama belum disetujui; pengelola RKAS mengasistensi
    // status usulan (menunggu/disetujui/tidak disetujui) hanya diubah akun "Mengelola RKAS" (bendahara/tim keuangan);
    // pengusul (tim keuangan atau akun GTK) hanya menulis usulannya sendiri, jadi usulan orang lain tidak bisa dihapus
    match /keu_usul/{id} {
      allow create: if (izinKhusus('keu_usul') || appOn('app_gtk')) && request.resource.data.by == request.auth.uid && request.resource.data.st == 'Diajukan';
      allow update: if izinKhusus('keu_rkas')
        || ((izinKhusus('keu_usul') || appOn('app_gtk')) && resource.data.by == request.auth.uid && resource.data.st != 'Disetujui'
            && request.resource.data.by == request.auth.uid && request.resource.data.st == 'Diajukan');
      allow delete: if izinKhusus('keu_rkas') || ((izinKhusus('keu_usul') || appOn('app_gtk')) && resource.data.by == request.auth.uid && resource.data.st != 'Disetujui');
    }
    match /keu_kak/{id} {
      allow create: if izinKhusus('keu_usul') && request.resource.data.by == request.auth.uid;
      allow update, delete: if izinKhusus('keu_rkas') || (izinKhusus('keu_usul') && resource.data.by == request.auth.uid);
    }
    match /keu_rkas/{id} { allow write: if izinKhusus('keu_rkas'); }
    match /keu_pagu/{id} { allow write: if izinKhusus('keu_rkas'); }
    match /keu_spj/{id} { allow write: if izinKhusus('keu_spj'); }
    match /keu_honor/{id} { allow write: if izinKhusus('keu_spj'); }
    match /keu_perjadin/{id} { allow write: if izinKhusus('keu_spj'); }
    // catatan temuan: ditulis langsung oleh operator yang punya hak "catatan"
    // riwayat cetak BAST: setiap akun mencatat cetakannya sendiri
    match /cetak/{id} {
      allow create: if isMember() && request.resource.data.by == request.auth.uid;
    }
    match /catatan/{id} {
      allow create: if izin('catatan')
        && request.resource.data.by == request.auth.uid
        && (isMaster() || request.resource.data.val == false)
        && request.resource.data.teks is string
        && request.resource.data.teks.size() < 5000;
      allow update: if izin('catatan')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'tl', 'tlBy', 'tlAt']);
    }
  }
}
