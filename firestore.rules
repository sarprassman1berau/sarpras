rules_version = '2';
// Aturan keamanan Sarpras SMAN 1 Berau.
// - Master  : email di daftar isMaster(). Membaca dan menulis semua data.
// - Operator: punya dokumen akun/{uid} dengan aktif == true. Membaca semua data,
//             tetapi hanya boleh menulis usulannya sendiri (usulan/{uid}) dan foto baru.
//             Perubahan operator baru berlaku setelah master menyetujuinya di aplikasi.
//             Menu dan tombol dibatasi sesuai centang hak akses di akun/{uid}.izin.
// - Catatan temuan: operator dengan hak "catatan" menulis langsung (tanpa validasi),
//             dan hanya boleh mengubah status serta tindak lanjutnya.
// - Selain itu: tidak bisa membaca atau menulis apa pun.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMaster() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ["sarpras.sman1berau@gmail.com"];
    }
    function isOperator() {
      return signedIn()
        && exists(/databases/$(database)/documents/akun/$(request.auth.uid))
        && get(/databases/$(database)/documents/akun/$(request.auth.uid)).data.aktif == true;
    }
    function isMember() { return isMaster() || isOperator(); }
    // hak akses operator (akun/{uid}.izin). Akun lama tanpa izin = akses penuh staf.
    function akunData() { return get(/databases/$(database)/documents/akun/$(request.auth.uid)).data; }
    function izin(k) {
      return isMaster() || (isOperator() && (!('izin' in akunData()) || akunData().izin.get(k, false) == true));
    }

    // semua data: anggota membaca, hanya master menulis
    match /{document=**} {
      allow read: if isMember();
      allow write: if isMaster();
    }
    // daftar akun: dibaca anggota (untuk menampilkan nama), dibaca juga oleh pemilik akunnya
    match /akun/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
    }
    // usulan perubahan: operator menulis dokumen usulannya sendiri
    match /usulan/{uid} {
      allow write: if isOperator() && request.auth.uid == uid;
    }
    // foto: operator boleh menambah foto baru (ukuran dibatasi), tidak boleh mengubah/menghapus
    match /foto/{id} {
      allow create: if isOperator()
        && request.resource.data.keys().hasOnly(["data", "by", "at"])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 600000;
    }
    // status terkini: setiap akun hanya memperbarui status dirinya sendiri
    match /online/{uid} {
      allow write: if isMember() && request.auth.uid == uid;
    }
    // chat tim: semua akun aktif boleh mengirim pesan atas namanya sendiri; hanya master yang menghapus
    match /chat/{id} {
      allow create: if isMember()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.teks is string
        && request.resource.data.teks.size() <= 2000;
    }
    // catatan temuan: ditulis langsung oleh operator yang punya hak "catatan"
    match /catatan/{id} {
      allow create: if izin('catatan')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.teks is string
        && request.resource.data.teks.size() < 5000;
      allow update: if izin('catatan')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'tl', 'tlBy', 'tlAt']);
    }
  }
}
